# ----------------------------------------------------------------------
# Orbit environment variables — TEMPLATE. Copy to `.env` and fill in.
# `.env` is gitignored: never commit real or dev secrets.
# On Vercel, set these in Project → Settings → Environment Variables.
# ----------------------------------------------------------------------

# --- Database ---
# Local dev: SQLite, no setup.
DATABASE_URL="file:./dev.db"
# Production: a Postgres connection string (Vercel Postgres / Neon / Supabase).
# The build switches the Prisma provider to postgresql automatically on Vercel.

# --- Auth (REQUIRED in production) ---
# Signs session JWTs. MUST be >= 32 chars in production or sign-in is disabled.
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Protects admin + cron endpoints (sent as Authorization: Bearer <value>).
# Generate: openssl rand -base64 32
CRON_SECRET=""

# --- AI matching + resume parsing (OPTIONAL) ---
# Provider order: OpenRouter -> Gemini -> Anthropic. Any one is enough.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_FALLBACK_MODEL="openrouter/free"  # auto-routes to a live free model
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Your live URL (used in magic-link emails + as the OpenRouter referer).
APP_URL="https://withinorbit.space"

# --- Email (REQUIRED for magic-link sign-in + booking emails in production) ---
# Get a key at resend.com. Verify a domain to email anyone (not just yourself).
RESEND_API_KEY=""
EMAIL_FROM="Orbit <hello@withinorbit.space>"

# --- Optional integrations ---
WHATSAPP_PROVIDER_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
