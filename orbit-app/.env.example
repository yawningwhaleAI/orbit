# ----------------------------------------------------------------------
# Orbit app environment variables
# Copy this file to `.env` and fill in as needed.
# The app RUNS WITH ZERO CONFIG in dev (SQLite + fallback matching).
# Everything below is optional until you deploy / want real services.
# ----------------------------------------------------------------------

# --- Database ---
# Dev default (SQLite, no setup). Leave as-is to run locally out of the box.
DATABASE_URL="file:./dev.db"
# Production (Supabase / Neon / Vercel Postgres): switch prisma/schema.prisma
# datasource provider to "postgresql" and set a Postgres connection string, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/orbit?schema=public"

# --- Auth ---
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-insecure-secret-change-me"
# Protects the weekly-match cron endpoint. Any random string.
CRON_SECRET="dev-cron-secret"

# --- AI (OPTIONAL) ---
# LLM powers the "why you two" reasons and resume parsing. Provider order:
# OpenRouter -> Anthropic -> templated fallback. Set ONE of these.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Embeddings (OPTIONAL) upgrade matching quality. Without a key, matching uses
# the lexical + complementary-tag scorer (works well at pilot scale).
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Public app URL (used in OpenRouter headers + calendar links). Optional.
APP_URL=""

# --- Notifications (OPTIONAL, stubbed/logged in dev) ---
RESEND_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# --- Google Calendar (OPTIONAL, scheduling works without it) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
