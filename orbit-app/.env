# ----------------------------------------------------------------------
# Orbit app environment variables
# Copy this file to `.env` and fill in as needed.
# The app RUNS WITH ZERO CONFIG in dev (SQLite + fallback matching).
# Everything below is optional until you deploy / want real services.
# ----------------------------------------------------------------------

# --- Database ---
# Dev default (SQLite, no setup). Leave as-is to run locally out of the box.
DATABASE_URL="file:./dev.db"
# Production (Supabase / Neon / Vercel Postgres): switch prisma/schema.prisma
# datasource provider to "postgresql" and set a Postgres connection string, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/orbit?schema=public"

# --- Auth ---
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-insecure-secret-change-me"
# Protects the weekly-match cron endpoint. Any random string.
CRON_SECRET="dev-cron-secret"

# --- AI matching + resume parsing (OPTIONAL) ---
# Provider order: Gemini -> OpenRouter -> Anthropic. Any one is enough.
# Gemini free tier is the most reliable: get a key at aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Without any key, Orbit uses tag-overlap matching + templated "why you two".
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Tried if the primary fails. "openrouter/free" auto-routes to any live free
# model, so a retired slug never breaks parsing. (Check live free models at
# /api/admin/or-models?secret=CRON_SECRET.)
OPENROUTER_FALLBACK_MODEL="openrouter/free"
# Your live URL — sent to OpenRouter as the referer (helps with free tiers).
APP_URL="https://withinorbit.space"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Model + embedding choices (sensible defaults used if blank)
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Notifications (OPTIONAL, stubbed/logged in dev) ---
# With RESEND_API_KEY set, members get a confirmation email when a coffee is
# booked. Without it, the send is logged and skipped (app still works).
# Free Resend tier: use the default EMAIL_FROM and you can only email the
# address you signed up with. Verify a domain in Resend to email any member.
RESEND_API_KEY=""
EMAIL_FROM="Orbit <onboarding@resend.dev>"
WHATSAPP_PROVIDER_API_KEY=""

# --- Google Calendar (OPTIONAL, scheduling works without it) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
